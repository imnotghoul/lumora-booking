{
  "name": "lumora-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:postgres:generate": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:postgres:migrate": "prisma migrate dev --schema prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.20",
    "react": "19.1.1",
    "react-dom": "19.2.7",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.20",
    "postcss": "8.5.10",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
